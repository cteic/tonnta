{
  "name": "tonnta-mono",
  "author": "Tonnta",
  "description": "Tonnta monorepo — surf conditions for Donabate and beyond",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@tonnta/web",
    "build:app:web": "turbo run build --filter=@tonnta/app",
    "build:worker": "turbo run build --filter=@tonnta/worker",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@tonnta/web",
    "dev:app": "turbo run dev --filter=@tonnta/app",
    "dev:worker": "turbo run dev --filter=@tonnta/worker",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "clean": "git clean -dfX",
    "prepare": "husky",
    "check:all": "turbo run check:all"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@tonnta/eslint-config": "workspace:*",
    "@tonnta/prettier-config": "workspace:*",
    "@tonnta/tsconfig-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.1",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "react-native-web": "^0.21.0"
    },
    "patchedDependencies": {
      "tamagui-loader@2.0.0-rc.42": "patches/tamagui-loader@2.0.0-rc.42.patch",
      "@tamagui/next-plugin@2.0.0-rc.42": "patches/@tamagui__next-plugin@2.0.0-rc.42.patch",
      "@tamagui/web@2.0.0-rc.42": "patches/@tamagui__web@2.0.0-rc.42.patch"
    }
  }
}

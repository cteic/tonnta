{
  "name": "tonnta-mono",
  "author": "Tonnta",
  "description": "Tonnta monorepo \u2014 surf conditions for Donabate and beyond",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@tonnta/web",
    "build:swim-web": "turbo run build --filter=@tonnta/swim-web",
    "build:app:web": "turbo run build --filter=@tonnta/app",
    "build:worker": "turbo run build --filter=@tonnta/worker",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@tonnta/web",
    "dev:swim-web": "turbo run dev --filter=@tonnta/swim-web",
    "dev:app": "turbo run dev --filter=@tonnta/app",
    "dev:worker": "turbo run dev --filter=@tonnta/worker",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yaml,yml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "lint": "turbo run lint && eslint scripts/verdict-contract.spec.ts vitest.contract.config.ts",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "pnpm run test:unit",
    "test:unit": "turbo run test:unit && pnpm run test:contract",
    "clean": "git clean -dfX",
    "prepare": "husky",
    "check:all": "turbo run check:all",
    "test:contract": "tsc --noEmit --project tsconfig.contract.json && vitest run --config vitest.contract.config.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@tonnta/eslint-config": "workspace:*",
    "@tonnta/prettier-config": "workspace:*",
    "@tonnta/tsconfig-config": "workspace:*",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.1",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "react-native-web": "^0.21.4",
      "react-native": "0.88.1",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "body-parser": "^2.4.0",
      "proxy-addr": "^2.0.8",
      "shell-quote": "^1.11.0",
      "node-forge": "^1.4.1",
      "browserslist": "^4.28.7",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2",
      "brace-expansion@1": "^1.1.22",
      "brace-expansion@2": "^2.1.8",
      "brace-expansion@5": "^5.0.13",
      "fast-uri@3": "^3.1.7",
      "glob@10": "^10.5.0",
      "js-yaml@4": "^4.3.2",
      "piscina@4": "^4.9.4",
      "undici@6": "^6.29.1",
      "undici@7": "^7.30.1",
      "vite@7": "^7.3.7"
    },
    "patchedDependencies": {
      "tamagui-loader@2.0.0-rc.42": "patches/tamagui-loader@2.0.0-rc.42.patch",
      "@tamagui/next-plugin@2.0.0-rc.42": "patches/@tamagui__next-plugin@2.0.0-rc.42.patch",
      "@tamagui/web@2.0.0-rc.42": "patches/@tamagui__web@2.0.0-rc.42.patch"
    }
  }
}

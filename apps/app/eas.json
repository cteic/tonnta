{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "pnpm": "9.15.0",
      "env": {
        "TAMAGUI_TARGET": "native"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base"
    }
  },
  "submit": {
    "production": {}
  }
}

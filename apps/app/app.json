{
  "expo": {
    "name": "Tonnta",
    "slug": "tonnta",
    "owner": "cteic",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "scheme": "tonnta",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B161E",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ie.tonnta.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B161E"
      },
      "package": "ie.tonnta.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B161E",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "4258949d-791a-4443-bff8-1a9e5c0213a1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/4258949d-791a-4443-bff8-1a9e5c0213a1"
    },
    "experiments": {
      "reactCompiler": true
    }
  }
}

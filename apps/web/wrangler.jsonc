{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tonnta-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Production. Pushes to main deploy here; Cloudflare creates the DNS
  // records and certificates for these hostnames on deploy.
  "workers_dev": true,
  "routes": [
    { "pattern": "tonnta.surf", "custom_domain": true },
    { "pattern": "www.tonnta.surf", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tonnta-web"
    }
  ],
  "env": {
    // Pushes to dev deploy here, on workers.dev only.
    "staging": {
      "name": "tonnta-web-staging",
      "routes": [],
      "workers_dev": true,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "tonnta-web-staging"
        }
      ]
    }
  }
}
